# Copy to .env and fill in. The CLI loads .env from the engine root on start.
# Variables already set in your shell win over this file.

# Every generative node goes through OpenRouter. Needed for any run without --offline.
OPENROUTER_API_KEY=

# Jev (TypeSafe AI) answers the judge questions. Without a key, an LLM judge
# through OpenRouter takes over: same interface, slower and more expensive.
TYPESAFE_API_KEY=

# 1 runs everything against deterministic mocks, with no network and no keys.
# Same as passing --offline.
FLOWS_OFFLINE=
