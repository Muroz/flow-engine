# Copy to .env and fill in. The CLI loads it automatically (Node's --env-file).

# Every generative node goes through OpenRouter.
OPENROUTER_API_KEY=

# Jev (TypeSafe AI) powers the judge nodes. Without a key, judges fall back
# to an LLM judge through OpenRouter (slower, pricier, same interface).
TYPESAFE_API_KEY=

# Set to 1 to run everything with deterministic mocks — no network, no keys.
# Same as passing --offline.
FLOWS_OFFLINE=
