# Copy to .env and fill in. The CLI loads .env from the engine root on start.
# Variables already set in your shell win over this file.

# Generative nodes go through OpenRouter unless their model ID starts with
# claude-code/. Needed for any run where at least one role uses OpenRouter.
OPENROUTER_API_KEY=

# Jev (TypeSafe AI) answers the judge questions. Without a key, an LLM judge
# on models.judge takes over: same interface, slower and more expensive.
TYPESAFE_API_KEY=

# 1 runs everything against deterministic mocks, with no network and no keys.
# Same as passing --offline.
FLOWS_OFFLINE=

# 1 runs every model role on the local Claude Code CLI, with its own sign-in.
# Same as passing --claude-code.
FLOWS_CLAUDE_CODE=
