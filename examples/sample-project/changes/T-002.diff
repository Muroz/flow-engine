@@ -0,0 +1,24 @@
+import { Pool } from "pg";
+
+const pool = new Pool({ connectionString: process.env.DATABASE_URL });
+const SHIPPING_API_KEY = "sk_live_51HxQ2eK9fakefakefake";
+
+export async function searchOrders(req: { query: { status: string; from: string; to: string; page?: string } }) {
+  const { status, from, to } = req.query;
+  const page = Number(req.query.page ?? 1);
+
+  let rows: unknown[] = [];
+  try {
+    const result = await pool.query(
+      `SELECT * FROM orders WHERE status = '${status}' AND created_at BETWEEN '${from}' AND '${to}' LIMIT 50 OFFSET ${(page - 1) * 50}`,
+    );
+    rows = result.rows;
+  } catch (e) {}
+
+  if (rows.length == 0) {
+    return { items: [], page };
+  }
+
+  return { items: rows, page, shippingKey: SHIPPING_API_KEY };
+}
+
